{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/products",
        "destination": "https://abdelraouf-harpy.github.io/products/",
        "type": 301
      },
      {
        "source": "/products/**",
        "destination": "https://abdelraouf-harpy.github.io/products/",
        "type": 301
      },
      {
        "source": "/saj.html",
        "destination": "/order.html?m=saj",
        "type": 301
      },
      {
        "source": "/saj-admin.html",
        "destination": "/admin.html?m=saj",
        "type": 301
      },
      {
        "source": "/king.html",
        "destination": "/order.html?m=king",
        "type": 301
      },
      {
        "source": "/king-admin.html",
        "destination": "/admin.html?m=king",
        "type": 301
      },
      {
        "source": "/manifest-saj.json",
        "destination": "/manifest.json?m=saj",
        "type": 301
      },
      {
        "source": "/admin-manifest-saj.json",
        "destination": "/admin-manifest.json?m=saj",
        "type": 301
      },
      {
        "source": "/manifest-king.json",
        "destination": "/manifest.json?m=king",
        "type": 301
      },
      {
        "source": "/admin-manifest-king.json",
        "destination": "/admin-manifest.json?m=king",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/saj",
        "destination": "/order.html?m=saj"
      },
      {
        "source": "/saj/**",
        "destination": "/order.html?m=saj"
      },
      {
        "source": "/king",
        "destination": "/order.html?m=king"
      },
      {
        "source": "/king/**",
        "destination": "/order.html?m=king"
      },
      {
        "source": "/order",
        "destination": "/order.html"
      },
      {
        "source": "/order/**",
        "destination": "/order.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/portfolio",
        "destination": "/portfolio.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "manifest*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "admin-manifest*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ]
  }
}

