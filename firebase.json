{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/master",
        "destination": "/master.html",
        "type": 301
      },
      {
        "source": "/products",
        "destination": "https://abdelraouf-harpy.github.io/products/",
        "type": 301
      },
      {
        "source": "/products/**",
        "destination": "https://abdelraouf-harpy.github.io/products/",
        "type": 301
      },
      {
        "source": "/aloo.html",
        "destination": "/order.html?m=aloo",
        "type": 301
      },
      {
        "source": "/aloo-admin.html",
        "destination": "/admin.html?m=aloo",
        "type": 301
      },
      {
        "source": "/manifest-aloo.json",
        "destination": "/manifest.json?m=aloo",
        "type": 301
      },
      {
        "source": "/admin-manifest-aloo.json",
        "destination": "/admin-manifest.json?m=aloo",
        "type": 301
      },
      {
        "source": "/elmetaashy.html",
        "destination": "/order.html?m=elmetaashy",
        "type": 301
      },
      {
        "source": "/elmetaashy-admin.html",
        "destination": "/admin.html?m=elmetaashy",
        "type": 301
      },
      {
        "source": "/manifest-elmetaashy.json",
        "destination": "/manifest.json?m=elmetaashy",
        "type": 301
      },
      {
        "source": "/admin-manifest-elmetaashy.json",
        "destination": "/admin-manifest.json?m=elmetaashy",
        "type": 301
      },
      {
        "source": "/king.html",
        "destination": "/order.html?m=king",
        "type": 301
      },
      {
        "source": "/king-admin.html",
        "destination": "/admin.html?m=king",
        "type": 301
      },
      {
        "source": "/manifest-king.json",
        "destination": "/manifest.json?m=king",
        "type": 301
      },
      {
        "source": "/admin-manifest-king.json",
        "destination": "/admin-manifest.json?m=king",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/order",
        "destination": "/order/index.html"
      },
      {
        "source": "/order/**",
        "destination": "/order/index.html"
      },
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/portfolio",
        "destination": "/portfolio.html"
      },
      {
        "source": "/cards",
        "destination": "/cards/index.html"
      },
      {
        "source": "/cards/",
        "destination": "/cards/index.html"
      },
      {
        "source": "/cards/dashboard",
        "destination": "/cards/dashboard.html"
      },
      {
        "source": "/cards/dashboard.html",
        "destination": "/cards/dashboard.html"
      },
      {
        "source": "/cards/profile.html",
        "destination": "/cards/profile.html"
      },
      {
        "source": "/cards/:username",
        "destination": "/cards/profile.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "cards/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "cards/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/cards/"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "manifest*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "admin-manifest*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ]
  }
}
